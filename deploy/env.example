BILI_SCROLL_ENVIRONMENT=production
BILI_SCROLL_HOST=127.0.0.1
BILI_SCROLL_PORT=8788
BILI_SCROLL_PUBLIC_URL=https://YOUR-DOMAIN
BILI_SCROLL_SECURE_COOKIES=true
BILI_SCROLL_DATA_DIR=/var/lib/bili-scroll
BILI_SCROLL_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES
BILI_SCROLL_CODEX_BIN=/usr/local/bin/codex
BILI_SCROLL_HERMES_BIN=/usr/local/bin/hermes
# BILI_SCROLL_CLAUDE_BIN=/usr/local/bin/claude
# Optional explicit home directories owned by the service account.
# BILI_SCROLL_CODEX_HOME=/var/lib/bili-scroll/agents/codex
# BILI_SCROLL_HERMES_HOME=/var/lib/bili-scroll/agents/hermes
# BILI_SCROLL_CLAUDE_HOME=/var/lib/bili-scroll/agents/claude
BILI_SCROLL_AGENT_TIMEOUT_SECONDS=1800
BILI_SCROLL_GLOBAL_CONCURRENCY=1
BILI_SCROLL_RETENTION_DAYS=365
# Optional local ASR through whisper.cpp.
# BILI_SCROLL_FFMPEG_BIN=/usr/bin/ffmpeg
# BILI_SCROLL_WHISPER_BIN=/usr/local/bin/whisper-cli
# BILI_SCROLL_WHISPER_MODEL_PATH=/var/lib/bili-scroll/models/ggml-small.bin

# Provider keys are normally saved per provider in the Admin UI (encrypted).
# BILI_SCROLL_PROVIDER_<ID>_API_KEY / _BASE_URL are optional overrides.
BILI_SCROLL_PROVIDER_TIMEOUT_SECONDS=20
BILI_SCROLL_DISABLE_JS_ADAPTERS=false
# Legacy DeepSeek aliases for provider id "deepseek".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

