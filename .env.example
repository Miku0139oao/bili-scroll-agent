# Production deployments must provide a stable 32-byte base64 key.
# Generate one with: openssl rand -base64 32
BILI_SCROLL_MASTER_KEY=

BILI_SCROLL_ENVIRONMENT=development
BILI_SCROLL_HOST=127.0.0.1
BILI_SCROLL_PORT=8788
BILI_SCROLL_PUBLIC_URL=http://127.0.0.1:8788
BILI_SCROLL_SECURE_COOKIES=false
BILI_SCROLL_DATA_DIR=.data
BILI_SCROLL_CODEX_BIN=codex
BILI_SCROLL_HERMES_BIN=hermes
BILI_SCROLL_CLAUDE_BIN=claude
# Optional explicit homes. When omitted, existing CODEX_HOME/HERMES_HOME/
# CLAUDE_CONFIG_DIR, then the default install locations, are auto-detected.
# BILI_SCROLL_CODEX_HOME=
# BILI_SCROLL_HERMES_HOME=
# BILI_SCROLL_CLAUDE_HOME=
BILI_SCROLL_AGENT_TIMEOUT_SECONDS=1800
BILI_SCROLL_GLOBAL_CONCURRENCY=1
BILI_SCROLL_RETENTION_DAYS=365
# Deliveries run after the run commits; this bounds that detached work.
BILI_SCROLL_DELIVERY_TIMEOUT_SECONDS=600
# Optional local ASR through whisper.cpp.
# BILI_SCROLL_FFMPEG_BIN=ffmpeg
# BILI_SCROLL_WHISPER_BIN=whisper-cli
# BILI_SCROLL_WHISPER_MODEL_PATH=ggml-small.bin

# Provider balances are configured per provider in the Admin UI, where the key
# is stored encrypted. These environment variables are optional overrides and
# always win over the stored value:
#   BILI_SCROLL_PROVIDER_<ID>_API_KEY   (ID upper-cased, - and . become _)
#   BILI_SCROLL_PROVIDER_<ID>_BASE_URL
BILI_SCROLL_PROVIDER_TIMEOUT_SECONDS=20
# Admin-authored JavaScript balance adapters are enabled by default. Set this to
# 1 to refuse kind=js entirely.
BILI_SCROLL_DISABLE_JS_ADAPTERS=false

# Legacy DeepSeek aliases, still honoured for provider id "deepseek".
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
